{
  "manifest_version": 3,
  "name": "Scry",
  "version": "0.1.0",
  "description": "History-first URL recall for Chrome.",
  "permissions": ["history", "sessions", "storage", "tabs"],
  "action": {
    "default_title": "Scry",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      }
    }
  }
}
