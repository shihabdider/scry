{
  "manifest_version": 3,
  "name": "Scry",
  "version": "0.1.0",
  "description": "History-first URL recall for Chrome.",
  "options_page": "options.html",
  "permissions": ["contextMenus", "history", "sessions", "storage", "tabs"],
  "icons": {
    "16": "icons/scry-16.png",
    "32": "icons/scry-32.png",
    "48": "icons/scry-48.png",
    "128": "icons/scry-128.png"
  },
  "action": {
    "default_title": "Scry",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scry-16.png",
      "32": "icons/scry-32.png",
      "48": "icons/scry-48.png",
      "128": "icons/scry-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      }
    },
    "save-current-tab-as-favorite": {
      "description": "Save the current tab to Scry favorites",
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      }
    }
  }
}
